# ===================================================================
# ตัวอย่างการตั้งค่า GeoServer
# ===================================================================
# ไฟล์นี้เป็นแค่ "ตัวอย่าง" ระบบไม่ได้อ่านไฟล์นี้โดยตรง
# ให้ตั้งเป็น environment variable ตอนรัน uvicorn แทน (ดูวิธีใน README_GEOSERVER.md)
#
# ถ้าไม่ตั้งอะไรเลย ระบบจะทำงานในโหมดภาพ PNG ตามปกติ (ไม่ต้องมี GeoServer)

# เปิด/ปิดการส่งผลลัพธ์ขึ้น GeoServer
GEOSERVER_ENABLED=true

# ที่อยู่ GeoServer (ค่าเริ่มต้นหลังติดตั้งคือพอร์ต 8080)
GEOSERVER_URL=http://localhost:8080/geoserver
# URL ที่ browser ใช้เรียก WMS (ถ้าใช้ Docker Compose ให้เป็น URL ของ Nginx)
GEOSERVER_PUBLIC_URL=http://localhost/geoserver

# บัญชีผู้ดูแล GeoServer (ค่าเริ่มต้นหลังติดตั้งใหม่คือ admin / geoserver)
# *** ถ้าใช้งานจริงควรเปลี่ยนรหัสผ่านก่อน ***
GEOSERVER_USER=admin
GEOSERVER_PASS=geoserver

# ชื่อ workspace / store / layer / style ที่ระบบจะสร้างให้อัตโนมัติ
GEOSERVER_WORKSPACE=sugarcane
GEOSERVER_STORE=suitability_store
GEOSERVER_LAYER=suitability_result
GEOSERVER_STYLE=suitability_fao

# โฟลเดอร์ที่จะเขียนไฟล์ผลลัพธ์ .tif ลงไป
# ต้องเป็นพาธที่ "เครื่องที่รัน GeoServer" เข้าถึงได้
# ถ้ารัน GeoServer กับ Python บนเครื่องเดียวกัน ไม่ต้องตั้งค่านี้ก็ได้
# (ค่าเริ่มต้นคือ backend/output/)
# GEOSERVER_DATA_DIR=C:\geoserver_data\sugarcane
